{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MaxwellM-GRC/grc-control-core/schemas/framework-mapping-v1.schema.json",
  "title": "POC Framework Mapping v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "control_id", "mappings"],
  "properties": {
    "$schema": { "type": "string", "format": "uri" },
    "schema_version": { "type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
    "control_id": { "type": "string", "pattern": "^(ITGC|RCM)-[A-Z][A-Z0-9]*-[0-9]{2,3}$" },
    "mappings": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/mapping" }
    }
  },
  "$defs": {
    "nonBlank": { "type": "string", "pattern": "\\S" },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mapping_id", "framework", "reference", "framework_source", "applicability",
        "assertion_ids", "evidence_outputs", "product_brief_summary",
        "decision_status", "remaining_validation"
      ],
      "properties": {
        "mapping_id": { "type": "string", "pattern": "^MAP-[0-9]{2}$" },
        "framework": { "$ref": "#/$defs/nonBlank" },
        "reference": { "$ref": "#/$defs/nonBlank" },
        "framework_source": { "type": "string", "format": "uri" },
        "applicability": { "$ref": "#/$defs/nonBlank" },
        "assertion_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*-[0-9]{2}$" }
        },
        "evidence_outputs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonBlank" }
        },
        "product_brief_summary": { "$ref": "#/$defs/nonBlank" },
        "decision_status": { "enum": ["Proposed", "Approved", "Rejected"] },
        "remaining_validation": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonBlank" }
        }
      }
    }
  }
}

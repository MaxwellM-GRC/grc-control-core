{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MaxwellM-GRC/grc-control-core/schemas/finding-v1.schema.json",
  "title": "GRC Finding v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "finding_id", "control_id", "rule_id", "subject_key", "severity",
    "title", "criteria", "condition", "cause", "effect", "observed_at", "evidence", "response"
  ],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
    "finding_id": { "$ref": "#/$defs/nonBlank" },
    "control_id": { "type": "string", "pattern": "^ITGC-[A-Z][A-Z0-9]*-[0-9]{2,3}$" },
    "rule_id": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*-[0-9]{2}$" },
    "subject_key": { "$ref": "#/$defs/nonBlank" },
    "severity": { "enum": ["info", "low", "medium", "high", "critical"] },
    "title": { "$ref": "#/$defs/nonBlank" },
    "criteria": { "$ref": "#/$defs/nonBlank" },
    "condition": { "$ref": "#/$defs/nonBlank" },
    "cause": { "$ref": "#/$defs/nonBlank" },
    "effect": { "$ref": "#/$defs/nonBlank" },
    "observed_at": { "type": "string", "format": "date-time" },
    "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidenceReference" } },
    "response": { "$ref": "control-metadata-v1.schema.json#/$defs/response" }
  },
  "$defs": {
    "nonBlank": { "type": "string", "pattern": "\\S" },
    "evidenceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "record_id", "locator"],
      "properties": {
        "source_id": { "$ref": "#/$defs/nonBlank" },
        "record_id": { "$ref": "#/$defs/nonBlank" },
        "locator": { "type": ["string", "null"] }
      }
    }
  }
}
